<?php

class Cidade
{
    private $nome;
    private $populacao;
    private $area;

    // metodos
    public function aumentarPopulacao($morePopu)
    {
        $this->populacao += $morePopu;
    }
    public function mudarNome($newname)
    {
        $this->nome = $newname;
        return $this->nome;
    }
    public function getDados()
    {
        $dados = "NOME: " . $this->nome . "\n";
        $dados .= "POPULAÇÃO: " . $this->populacao . "\n";
        $dados .= "AREA: " . $this->area . "km\n";

        return $dados;
    }
    // get set go!

    public function getNome()
    {
        return $this->nome;
    }

    public function setNome($nome): self
    {
        $this->nome = $nome;

        return $this;
    }

    public function getPopulacao()
    {
        return $this->populacao;
    }

    public function setPopulacao($populacao): self
    {
        $this->populacao = $populacao;

        return $this;
    }

    public function getArea()
    {
        return $this->area;
    }

    public function setArea($area): self
    {
        $this->area = $area;

        return $this;
    }
}

$cidade = new Cidade();
$cidade->setNome(readline("Qual o nome da sua cidade?: "));
$cidade->setPopulacao(readline("Qual a area da sua cidade?: "));
$cidade->setArea(readline("Qual a população da sua cidade?: "));

do {
    echo "|    --- C I V ---    |\n";
    echo "|1°STATS              |\n";
    echo "|2°MUDAR NOME         |\n";
    echo "|3°AUMENTAR POPULAÇÃO |\n";
    echo "|0°SAIR               |\n";
    $select = readline("|Oq tu qr fazer: ");
    if ($select == 1) {
        echo $cidade->getDados();
        readline("Digite ENTER para continuar......");
        system("clear");
    } elseif ($select == 2) {
        $newname = readline("Qual o novo nome da sua cidade?: ");
        $cidade->mudarNome($newname);
        readline("Digite ENTER para continuar......");
        system("clear");
    } elseif ($select == 3) {
        $morePopu = readline("Qual o aumento da população?: ");
        $cidade->aumentarPopulacao($morePopu);
        readline("Digite ENTER para continuar......");
        system("clear");
    }
} while ($select != 0);
